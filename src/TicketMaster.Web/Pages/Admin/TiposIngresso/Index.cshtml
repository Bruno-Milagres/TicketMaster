@page
@model TicketMaster.Web.Pages.Admin.TiposIngresso.IndexModel
@{
    ViewData["Title"] = "Tipos de Ingresso";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <span>Total: @Model.Tipos.Count tipo(s)</span>
    <a asp-page="Criar" class="btn btn-primary btn-sm">
        <i class="fa-solid fa-plus me-1"></i>Novo Tipo
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <table class="table table-hover" id="tabelaTipos">
            <thead><tr><th>Nome</th><th>Evento</th><th>Preço</th><th>Disponível</th><th>Ações</th></tr></thead>
            <tbody>
                @foreach (var t in Model.Tipos)
                {
                    <tr>
                        <td>@t.Nome</td>
                        <td>@t.Evento?.Title</td>
                        <td>@t.Preco.ToString("C2")</td>
                        <td>@t.QuantidadeDisponivel</td>
                        <td>
                            <a asp-page="Editar" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                            <form asp-page-handler="Excluir" asp-route-id="@t.Id" method="post" style="display:inline"
                                  onsubmit="return confirm('Excluir @t.Nome?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>$('#tabelaTipos').DataTable({ language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json' } });</script>
}
