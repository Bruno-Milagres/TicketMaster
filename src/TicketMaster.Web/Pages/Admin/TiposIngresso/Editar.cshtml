@page "{id}"
@model TicketMaster.Web.Pages.Admin.TiposIngresso.EditarModel
@{
    ViewData["Title"] = "Editar Tipo de Ingresso";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="EventoId" class="form-label">Evento</label>
                <select asp-for="EventoId" asp-items="Model.EventosOptions" class="form-select"></select>
            </div>
            <div class="mb-3">
                <label asp-for="Nome" class="form-label">Nome</label>
                <input asp-for="Nome" class="form-control" required />
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Preco" class="form-label">Preço</label>
                    <input asp-for="Preco" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Quantidade" class="form-label">Disponível</label>
                    <input asp-for="Quantidade" type="number" class="form-control" required />
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary"><i class="fa-solid fa-save me-1"></i>Salvar</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
