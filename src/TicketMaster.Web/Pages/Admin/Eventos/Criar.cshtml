@page
@model TicketMaster.Web.Pages.Admin.Eventos.CriarModel
@{
    ViewData["Title"] = "Criar Evento";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Titulo" class="form-label">Título</label>
                <input asp-for="Titulo" class="form-control" required />
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Data" class="form-label">Data e Hora</label>
                    <input asp-for="Data" type="datetime-local" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="SalaId" class="form-label">Sala</label>
                    <select asp-for="SalaId" asp-items="Model.SalasOptions" class="form-select" required>
                        <option value="">— Selecione —</option>
                    </select>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<EventStatus>()" class="form-select"></select>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary"><i class="fa-solid fa-check me-1"></i>Criar</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
