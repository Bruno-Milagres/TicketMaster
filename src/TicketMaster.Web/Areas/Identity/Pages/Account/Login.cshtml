@page
@model LoginModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <span class="auth-icon">
            <i class="fa-solid fa-ticket"></i>
        </span>
        <h1 class="auth-title">Bem-vindo de volta</h1>
        <p class="auth-subtitle">Entre com sua conta para continuar</p>

        <form id="account" method="post" autocomplete="on">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            <div class="field-group">
                <label asp-for="Input.Email" class="field-label">
                    <i class="fa-regular fa-envelope me-1"></i>E-mail
                </label>
                <input asp-for="Input.Email"
                       class="field-input"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="voce@exemplo.com" />
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>

            <div class="field-group">
                <label asp-for="Input.Password" class="field-label">
                    <i class="fa-solid fa-lock me-1"></i>Senha
                </label>
                <input asp-for="Input.Password"
                       class="field-input"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>

            <div class="remember-row">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe">Lembrar minha conta</label>
            </div>

            <button id="login-submit" type="submit" class="btn-auth">
                <i class="fa-solid fa-arrow-right-to-bracket me-2"></i>Entrar
            </button>
        </form>

        <div class="auth-divider">ou</div>

        <div class="auth-footer">
            Não tem uma conta?&nbsp;
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Registre-se</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
