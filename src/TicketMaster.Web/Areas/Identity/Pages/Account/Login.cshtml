@page
@model LoginModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="auth-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-7 col-xl-5">
                <div class="auth-card tm-hover-lift">
                    <div class="text-center mb-4">
                        <span class="badge text-bg-primary mb-2">Acesso</span>
                        <div class="auth-icon mb-2">
                            <i class="fa-solid fa-ticket"></i>
                        </div>
                        <h1 class="auth-title">Bem-vindo de volta</h1>
                        <p class="auth-subtitle mb-0">Entre com sua conta para continuar</p>
                    </div>

                    <form id="account" method="post" autocomplete="on">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">E-mail</label>
                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="username"
                                   aria-required="true"
                                   placeholder="voce@exemplo.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label">Senha</label>
                            <input asp-for="Input.Password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   aria-required="true"
                                   placeholder="••••••••" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label" asp-for="Input.RememberMe">Lembrar minha conta</label>
                        </div>

                        <button id="login-submit" type="submit" class="btn btn-primary w-100">
                            <i class="fa-solid fa-arrow-right-to-bracket me-2"></i>Entrar
                        </button>
                    </form>

                    <div class="auth-divider">ou</div>

                    <div class="auth-footer mt-0">
                        Não tem uma conta?&nbsp;
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Registre-se</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
