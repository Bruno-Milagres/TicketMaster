@page
@model RegisterModel
@{
    ViewData["Title"] = "Criar conta";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <span class="auth-icon">
            <i class="fa-solid fa-user-plus"></i>
        </span>
        <h1 class="auth-title">Criar sua conta</h1>
        <p class="auth-subtitle">Preencha os dados abaixo para se registrar</p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            <div class="field-group">
                <label asp-for="Input.Email" class="field-label">
                    <i class="fa-regular fa-envelope me-1"></i>E-mail
                </label>
                <input asp-for="Input.Email"
                       class="field-input"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="voce@exemplo.com" />
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>

            <div class="field-group">
                <label asp-for="Input.Password" class="field-label">
                    <i class="fa-solid fa-lock me-1"></i>Senha
                </label>
                <input asp-for="Input.Password"
                       class="field-input"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>

            <div class="field-group">
                <label asp-for="Input.ConfirmPassword" class="field-label">
                    <i class="fa-solid fa-lock me-1"></i>Confirmar senha
                </label>
                <input asp-for="Input.ConfirmPassword"
                       class="field-input"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
            </div>

            <button id="registerSubmit" type="submit" class="btn-auth">
                <i class="fa-solid fa-user-plus me-2"></i>Criar conta
            </button>
        </form>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="auth-divider">ou continue com</div>
            <div class="external-section">
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" class="btn-external" name="provider" value="@provider.Name" title="Registrar com @provider.DisplayName">
                            @provider.DisplayName
                        </button>
                    }
                </form>
            </div>
        }

        <div class="auth-footer">
            Já tem uma conta?&nbsp;
            <a asp-page="./Login">
                <i class="fa-solid fa-arrow-right-to-bracket me-1"></i>Entrar
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
