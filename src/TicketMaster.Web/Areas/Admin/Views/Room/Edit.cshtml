@model CriarSalaViewModel
@{
    ViewData["Title"] = "Editar Sala";
    Layout = "_Layout";
    var salaId = Context.Request.RouteValues["id"];
}

<div class="container tm-page">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="Index" class="tm-btn tm-btn-secondary tm-btn-sm">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h1 class="tm-section-title mb-0">
            <i class="fa-solid fa-pen me-2" style="color:var(--accent);"></i>Editar Sala
        </h1>
    </div>

    <form asp-action="Edit" asp-route-id="@salaId" method="post" id="roomForm">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <div class="col-12 col-md-6">
                <div class="tm-card">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="Nome" class="tm-form-label">Nome da Sala</label>
                            <input asp-for="Nome" class="tm-form-control" required />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <label asp-for="MaxColumns" class="tm-form-label">Colunas</label>
                                <input asp-for="MaxColumns" type="number" min="1" max="20" class="tm-form-control"
                                       onchange="gerarGrid()" />
                            </div>
                            <div class="col-6">
                                <label asp-for="MaxRows" class="tm-form-label">Linhas</label>
                                <input asp-for="MaxRows" type="number" min="1" max="20" class="tm-form-control"
                                       onchange="gerarGrid()" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="tm-card">
                    <div class="card-body p-4">
                        <p class="tm-form-label mb-1">Mapa de Assentos</p>
                        <p style="color:var(--text-muted);font-size:0.8rem;margin-bottom:1rem;">Clique nos assentos para ativar/desativar.</p>
                        <div id="seatGrid" class="seat-map-grid" style="display:grid;gap:4px;justify-content:start;"></div>
                        <input type="hidden" asp-for="AssentosJson" id="AssentosJson" />
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="tm-btn tm-btn-primary">
                <i class="fa-solid fa-save me-1"></i>Salvar
            </button>
            <a asp-action="Index" class="tm-btn tm-btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        var assentosCarregados = document.getElementById('AssentosJson').value;

        function gerarGrid() {
            var cols = parseInt(document.getElementById('MaxColumns').value) || 0;
            var rows = parseInt(document.getElementById('MaxRows').value) || 0;
            var grid = document.getElementById('seatGrid');

            grid.style.gridTemplateColumns = 'repeat(' + cols + ', 32px)';
            grid.innerHTML = '';

            var assentosAtivos = [];
            if (assentosCarregados) {
                try { assentosAtivos = JSON.parse(assentosCarregados); } catch(e) {}
            }

            for (var y = 1; y <= rows; y++) {
                for (var x = 1; x <= cols; x++) {
                    var seat = document.createElement('div');
                    seat.className = 'seat-editor';
                    seat.dataset.x = x;
                    seat.dataset.y = y;

                    var codigo = String.fromCharCode(64 + y) + x;
                    seat.textContent = codigo;

                    var ativo = assentosAtivos.some(function(a) { return a.seatCode === codigo; });
                    seat.dataset.ativo = ativo ? 'true' : 'false';

                    seat.addEventListener('click', function() {
                        var a = this.dataset.ativo === 'true';
                        this.dataset.ativo = a ? 'false' : 'true';
                        atualizarAssentos();
                    });

                    grid.appendChild(seat);
                }
            }
        }

        function atualizarAssentos() {
            var assentos = [];
            document.querySelectorAll('.seat-editor').forEach(function(el) {
                if (el.dataset.ativo === 'true') {
                    assentos.push({
                        seatCode: el.textContent,
                        coordX: parseInt(el.dataset.x),
                        coordY: parseInt(el.dataset.y),
                        type: 'Standard'
                    });
                }
            });
            document.getElementById('AssentosJson').value = JSON.stringify(assentos);
        }

        gerarGrid();
    </script>
}
