@model List<AdminUserView>
@{
    ViewData["Title"] = "Gerenciar Administradores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0"><i class="fa-solid fa-shield-halved me-2"></i>Administradores</h1>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>E-mail</th>
                    <th>Roles</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.Email</td>
                        <td>
                            @foreach (var r in u.Roles.Split(", "))
                            {
                                var badge = r == "AdminGeral" ? "bg-danger" : "bg-warning text-dark";
                                <span class="badge @badge me-1">@r</span>
                            }
                        </td>
                        <td class="text-end">
                            @foreach (var r in u.Roles.Split(", "))
                            {
                                <form method="post" asp-action="RemoveRole" class="d-inline"
                                      onsubmit="return confirm('Remover role @r de @u.Email?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <input type="hidden" name="role" value="@r" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger me-1"
                                            title="Remover @r">
                                        <i class="fa-solid fa-user-minus"></i> @r
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
