@model TicketMaster.Web.Models.EventoFormViewModel
@{
    ViewData["Title"] = "Editar Evento";
    var eventoId = ViewBag.EventoId as Guid?;
}

<div class="container tm-page">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="Index" class="tm-btn tm-btn-secondary tm-btn-sm">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h1 class="tm-section-title mb-0">
            <i class="fa-solid fa-edit me-2" style="color:var(--accent);"></i>Editar Evento
        </h1>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="tm-card">
                <div class="card-body p-4">
                    <form method="post" asp-action="Edit" asp-route-id="@eventoId">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="tm-alert tm-alert-danger mb-3"></div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Title" class="tm-form-label">Título</label>
                                <input asp-for="Title" class="tm-form-control" required />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="EventDate" class="tm-form-label">Data do Evento</label>
                                <input asp-for="EventDate" class="tm-form-control" type="datetime-local" required />
                                <span asp-validation-for="EventDate" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="tm-btn tm-btn-primary">
                                <i class="fa-solid fa-save me-1"></i>Salvar
                            </button>
                            <a asp-action="Index" class="tm-btn tm-btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="tm-card">
                <div class="card-body p-4 text-center">
                    <p class="tm-form-label mb-3">Imagem do Evento</p>
                    @if (!string.IsNullOrEmpty(ViewBag.ImagemUrl as string))
                    {
                        <img src="@ViewBag.ImagemUrl" alt="Imagem atual" class="img-fluid rounded mb-3" style="max-height:140px;object-fit:cover;width:100%;" />
                    }
                    <form method="post" asp-action="UploadImagem" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="eventId" value="@eventoId" />
                        <input type="file" name="imagemEvento" class="tm-form-control mb-2" accept=".jpg,.jpeg,.png,.webp" style="font-size:0.82rem;" />
                        <button type="submit" class="tm-btn tm-btn-outline tm-btn-sm w-100">
                            <i class="fa-solid fa-upload me-1"></i>Upload
                        </button>
                    </form>
                </div>
            </div>

            <div class="tm-card mt-4">
                <div class="card-body p-4">
                    <p class="tm-form-label mb-3">Publicar / Cancelar</p>
                    <form method="post" asp-action="Publicar">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@eventoId" />
                        <button type="submit" class="tm-btn tm-btn-success tm-btn-sm w-100 mb-2">
                            <i class="fa-solid fa-check me-1"></i>Publicar Evento
                        </button>
                    </form>
                    <form method="post" asp-action="Cancelar">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@eventoId" />
                        <button type="submit" class="tm-btn tm-btn-danger tm-btn-sm w-100"
                                onclick="return confirm('Cancelar este evento?')">
                            <i class="fa-solid fa-ban me-1"></i>Cancelar Evento
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
