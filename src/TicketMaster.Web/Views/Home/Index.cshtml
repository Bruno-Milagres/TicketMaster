@using TicketMaster.Application.Common
@model PagedResult<TicketMaster.Domain.Entities.Event>

@{
    var eventos = Model.Itens;
    string? action = ViewContext.RouteData.Values["action"]?.ToString();
    string? controller = ViewContext.RouteData.Values["controller"]?.ToString();
}

<section class="mb-4 mb-md-5">
    <div class="row g-4 align-items-center">
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm h-100 tm-hover-lift">
                <div class="card-body p-4 p-md-5">
                    <span class="badge text-bg-primary mb-3">TicketMaster Hub</span>
                    <h1 class="display-5 fw-bold mb-3">Descubra o próximo espetáculo da sua agenda</h1>
                    <p class="lead text-muted mb-4">Escolha seu evento, selecione seu assento e finalize o pagamento em poucos cliques.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge rounded-pill text-bg-light border">Reserva em tempo real</span>
                        <span class="badge rounded-pill text-bg-light border">Pagamento rápido</span>
                        <span class="badge rounded-pill text-bg-light border">Experiência responsiva</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm tm-hover-lift">
                <img src="~/img/home-hero-evento.jpg" class="card-img-top placeholder-img" alt="Imagem promocional do evento" />
                <div class="card-body">
                    <h2 class="h5 mb-2">Pronto para reservar?</h2>
                    <p class="text-muted mb-0">Explore os eventos disponíveis e garanta seu lugar.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@if (!eventos.Any())
{
    <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>Nenhum evento disponível no momento. Tente novamente em instantes.</span>
    </div>
}
else
{
    <section>
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h4 mb-0">Eventos disponíveis</h2>
            <span class="badge text-bg-secondary">@Model.Total evento(s)</span>
        </div>

        <div class="row g-4">
            @foreach (var evento in eventos)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 shadow-sm tm-hover-lift">
                        <img src="~/img/evento-card-placeholder.jpg" class="card-img-top placeholder-img" alt="Imagem do evento @evento.Title" />
                        <div class="card-body">
                            <h3 class="h5 card-title fw-bold">@evento.Title</h3>
                            <p class="card-text text-muted mb-3">
                                <i class="fa-regular fa-calendar-days me-2"></i>@evento.EventDate.ToString("dd/MM/yyyy HH:mm")
                            </p>
                            <span class="badge text-bg-success">Ingressos disponíveis</span>
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3">
                            <a asp-controller="Ticket" asp-action="Index" asp-route-eventId="@evento.Id" class="btn btn-primary w-100">
                                Ver Ingressos
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav class="mt-4" aria-label="Navegação de páginas">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(!Model.TemAnterior ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPaginas; p++)
                    {
                        <li class="page-item @(p == Model.Pagina ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(!Model.TemProxima ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina + 1)">Próxima</a>
                    </li>
                </ul>
            </nav>
        }
    </section>
}
