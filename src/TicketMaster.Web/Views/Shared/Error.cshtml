@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="page-card" style="max-width: 600px; margin: 0 auto; text-align: center;">
    <div style="font-size: 3rem; color: var(--color-danger); margin-bottom: 1rem;">
        <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <h1 style="font-family: var(--font-serif); color: var(--color-danger);">Algo deu errado</h1>
    <p style="color: var(--color-text-muted);">Ocorreu um erro ao processar sua solicitação.</p>

    @if (Model.ShowRequestId)
    {
        <p style="font-size: 0.85rem; color: var(--color-text-muted);">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <div style="margin-top: 1.5rem;">
        <a asp-controller="Ticket" asp-action="Index" class="btn btn-primary">
            <i class="fa-solid fa-arrow-left me-2"></i>Voltar ao início
        </a>
    </div>
</div>
