@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm text-center tm-hover-lift">
            <div class="card-body p-4 p-md-5">
                <span class="badge text-bg-danger mb-3">Falha na solicitação</span>
                <div class="display-5 text-danger mb-3">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h1 class="h2 text-danger mb-2">Algo deu errado</h1>
                <p class="text-muted mb-3">Ocorreu um erro ao processar sua solicitação.</p>

                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted mb-4">
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </p>
                }

                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="fa-solid fa-arrow-left me-2"></i>Voltar ao início
                </a>
            </div>
        </div>
    </div>
</div>
