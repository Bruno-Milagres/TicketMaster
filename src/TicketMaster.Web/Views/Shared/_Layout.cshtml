<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TicketMaster</title>

    @* Fontes *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=DM+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />

    @* Font Awesome *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="tm-navbar navbar navbar-expand-md">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    TicketMaster
                </a>

                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navMain"
                        aria-controls="navMain" aria-expanded="false" aria-label="Abrir menu">
                    <i class="fa-solid fa-bars" style="color: var(--text-secondary);"></i>
                </button>

                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Eventos</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="MeusPedidos">Meus Pedidos</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.IsInRole("AdminGeral") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Admin</a>
                                <ul class="dropdown-menu dropdown-menu-end tm-dropdown">
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Eventos" asp-action="Index"><i class="fa-solid fa-calendar me-2"></i>Eventos</a></li>
                                    @if (User.IsInRole("AdminGeral"))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="AdminGeral" asp-action="Index"><i class="fa-solid fa-users-gear me-2"></i>Admins</a></li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 ms-2">
                        <partial name="_LoginPartial" />
                        <button id="cart-toggle" class="btn-theme-toggle" title="Minhas reservas" aria-label="Carrinho" style="position:relative;">
                            <i class="fa-solid fa-cart-shopping"></i>
                            <span id="cart-count" style="display:none;position:absolute;top:-4px;right:-4px;background:var(--accent);color:#fff;border-radius:50%;width:18px;height:18px;font-size:0.6rem;display:flex;align-items:center;justify-content:center;font-weight:700;"></span>
                        </button>
                        <button id="btn-theme-toggle" class="btn-theme-toggle" title="Alternar tema" aria-label="Alternar tema claro/escuro">
                            <i class="fa-solid fa-sun"></i>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="tm-page">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    @* Cart popup *@
    <div id="cart-popup" class="cart-popup">
        <div style="padding:0.75rem 1rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
            <strong style="font-size:0.85rem;">Minhas Reservas</strong>
            <span id="cart-count-header" class="tm-badge tm-badge-gold" style="display:none;"></span>
        </div>
        <div id="cart-items" style="max-height:240px;overflow-y:auto;"></div>
        <div style="padding:0.75rem 1rem;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:0.85rem;">Total</span>
            <span id="cart-total" style="font-family:var(--font-mono);color:var(--gold);font-weight:600;">R$ 0,00</span>
        </div>
        <div style="padding:0.75rem 1rem;border-top:1px solid var(--border);">
            <a id="cart-pay-btn" href="#" class="tm-btn tm-btn-primary tm-btn-sm w-100" style="display:none;" onclick="payAllReservations();return false;">
                <i class="fa-regular fa-circle-check me-1"></i>Ir para Pagamento
            </a>
        </div>
    </div>

    <footer class="tm-footer">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>&copy; @DateTime.Now.Year TicketMaster — Teatro</span>
            <span class="tm-badge tm-badge-vinho">Plataforma de Ingressos</span>
        </div>
    </footer>

    @* Toast container *@
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toast-container"></div>

    @if (TempData["Sucesso"] != null)
    {
        <script>document.addEventListener('DOMContentLoaded', function () { showToast('@TempData["Sucesso"]', 'success'); });</script>
    }
    @if (TempData["Erro"] != null)
    {
        <script>document.addEventListener('DOMContentLoaded', function () { showToast('@TempData["Erro"]', 'danger'); });</script>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
