@{
    ViewData["Title"] = "Seu Ingresso";
    var qrData = $"data:image/png;base64,{ViewBag.QrCodeBase64}";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body text-center p-5">
                <i class="fa-solid fa-ticket text-primary" style="font-size:3rem;"></i>
                <h1 class="h3 mt-3">@ViewBag.EventName</h1>
                <p class="text-muted">Assento: <strong>@ViewBag.SeatCode</strong></p>

                <div class="my-4">
                    <img src="@qrData" alt="QR Code do ingresso" class="img-fluid" style="max-width:250px;" />
                </div>

                <p class="small text-muted">Apresente este QR Code na entrada do evento.</p>

                <button class="btn btn-primary" onclick="window.print()">
                    <i class="fa-solid fa-print me-1"></i>Imprimir
                </button>
                <a asp-controller="Home" asp-action="MeusPedidos" class="btn btn-outline-secondary ms-2">
                    <i class="fa-solid fa-arrow-left me-1"></i>Voltar
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        @@media print {
            header, footer, .btn, .navbar { display: none !important; }
            .card { border: none !important; box-shadow: none !important; }
        }
    </style>
}
