@{
}
@using TicketMaster.Domain.Entities
@model IEnumerable<Ticket>

@{
    ViewData["Title"] = "Mapa de Assentos";
}

<div class="container mt-5">
    <h2 class="mb-4">🎟️ Escolha seu Assento</h2>

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Ops!</strong> @TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Show!</strong> @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var ticket in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm text-center">
                    <div class="card-body">
                        <h1 class="display-4 fw-bold">@ticket.AssentoCodigo</h1>
                        
                        @if (ticket.Status == TicketStatus.Disponivel)
                        {
                            <span class="badge bg-success fs-6 mb-3">Livre</span>
                            
                            <form asp-controller="Ticket" asp-action="Reservar" method="post">
                                <input type="hidden" name="assentoCodigo" value="@ticket.AssentoCodigo" />
                                <button type="submit" class="btn btn-primary w-100">Reservar Agora</button>
                            </form>
                        }
                        else if (ticket.Status == TicketStatus.Reservado)
                        {
                            <span class="badge bg-warning text-dark fs-6 mb-3">Reservado</span>
                            <button class="btn btn-secondary w-100" disabled>Indisponível</button>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6 mb-3">Vendido</span>
                            <button class="btn btn-secondary w-100" disabled>Esgotado</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>