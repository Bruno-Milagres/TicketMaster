@using TicketMaster.Domain.Entities
@model IEnumerable<Ticket>

@{
    ViewData["Title"] = "Mapa de Assentos";
}

<div class="d-flex align-items-baseline justify-content-between mb-1">
    <h1 class="ticket-page-title">
        <i class="fa-solid fa-map-location-dot me-2"></i>Mapa de Assentos
    </h1>
</div>
<p class="ticket-page-subtitle">Escolha seu assento e garanta seu ingresso</p>

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i><strong>Ops!</strong> @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i><strong>Show!</strong> @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
    @foreach (var ticket in Model)
    {
        <div class="col">
            <div class="ticket-card">
                <div class="ticket-seat-code">@ticket.AssentoCodigo</div>

                @if (ticket.Status == TicketStatus.Disponivel)
                {
                    <span class="ticket-status-badge status-available">
                        <i class="fa-solid fa-circle-check me-1"></i>Livre
                    </span>
                    <form asp-controller="Ticket" asp-action="Reservar" method="post" class="w-100">
                        <input type="hidden" name="assentoCodigo" value="@ticket.AssentoCodigo" />
                        <button type="submit" class="btn btn-primary w-100 mt-2">
                            <i class="fa-solid fa-lock me-1"></i>Reservar Agora
                        </button>
                    </form>
                }
                else if (ticket.Status == TicketStatus.Reservado)
                {
                    <span class="ticket-status-badge status-reserved">
                        <i class="fa-solid fa-clock me-1"></i>Reservado
                    </span>
                    <button class="btn btn-outline-secondary w-100 mt-2" disabled>
                        <i class="fa-solid fa-ban me-1"></i>Indisponível
                    </button>
                }
                else
                {
                    <span class="ticket-status-badge status-sold">
                        <i class="fa-solid fa-xmark me-1"></i>Vendido
                    </span>
                    <button class="btn btn-outline-secondary w-100 mt-2" disabled>
                        <i class="fa-solid fa-ban me-1"></i>Esgotado
                    </button>
                }
            </div>
        </div>
    }
</div>
