@model IEnumerable<TicketMaster.Domain.Entities.Ticket>
@using System.Text.Json

@{
    ViewData["Title"] = "Mapa de Assentos";
}

<div class="seat-map-page">
    <div class="seat-map-header text-center mb-4">
        <h1 class="ticket-page-title mb-2">
            <i class="fa-solid fa-ticket me-2"></i>Ingressos para:
            <span class="seat-map-event-name">@ViewBag.EventName</span>
        </h1>
        <p class="ticket-page-subtitle mb-3">Selecione um assento disponível para continuar com a reserva.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>Voltar para o Hub
        </a>
    </div>

    <div class="seat-map-legend mb-3" aria-label="Legenda de status dos assentos">
        <span class="seat-legend-item">
            <span class="seat-legend-dot seat-disponivel"></span>Disponível
        </span>
        <span class="seat-legend-item">
            <span class="seat-legend-dot seat-reservado"></span>Reservado
        </span>
        <span class="seat-legend-item">
            <span class="seat-legend-dot seat-vendido"></span>Vendido
        </span>
        <span class="seat-legend-item">
            <span class="seat-legend-dot seat-minha-reserva"></span>Minha Reserva
        </span>
    </div>

    <div class="seat-map-wrapper">
        <div id="seat-map" class="seat-map-grid" aria-live="polite"></div>
    </div>
</div>

<!-- Modal de gerenciamento de reserva -->
<div class="modal fade" id="modalMinhaReserva" tabindex="-1" aria-labelledby="modalMinhaReservaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalMinhaReservaLabel">
                    <i class="fa-solid fa-couch me-2"></i>Gerenciar Reserva
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p id="modalReservaMsg"></p>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-outline-danger" id="btnCancelarReserva">
                    <i class="fa-solid fa-xmark me-1"></i>Cancelar Reserva
                </button>
                <div>
                    <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">
                        <i class="fa-solid fa-arrow-left me-1"></i>Voltar
                    </button>
                    <button type="button" class="btn btn-success" id="btnIrPagamento">
                        <i class="fa-solid fa-credit-card me-1"></i>Ir ao Pagamento
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="hiddenEventId" value="@ViewBag.EventId" />
<input type="hidden" id="hiddenCurrentUserId" value="@ViewBag.CurrentUserId" />
<script>
    const roomLayout = @Html.Raw(JsonSerializer.Serialize(ViewBag.RoomLayout));
    const tickets = @Html.Raw(JsonSerializer.Serialize(Model));
</script>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const eventId = document.getElementById("hiddenEventId")?.value;
        const currentUserId = document.getElementById("hiddenCurrentUserId")?.value; 
        const mapContainer = document.getElementById("seat-map");

        if (!eventId || !mapContainer || !roomLayout?.Seats) {
        console.error("Dados inválidos para renderizar o mapa de assentos.");
        } else {
        mapContainer.style.setProperty('--max-cols', roomLayout.MaxColumns);
        mapContainer.style.setProperty('--max-rows', roomLayout.MaxRows);

        roomLayout.Seats.forEach(coord => {
        const ticketState = tickets.find(t => t.AssentoCodigo === coord.SeatCode);
        const status = ticketState ? ticketState.Status : 0;
        const donoId = ticketState ? ticketState.UsuarioId : null; 

        const btn = document.createElement("button");
        btn.id = `btn-${coord.SeatCode}`;
        btn.type = "button";
        btn.innerText = coord.SeatCode;
        btn.classList.add("seat-btn");
        btn.style.gridColumn = coord.CoordX;
        btn.style.gridRow = coord.CoordY;

        applySeatStatus(btn, status, donoId, coord.SeatCode);

        mapContainer.appendChild(btn);
        });

        const connection = new signalR.HubConnectionBuilder()
        .withUrl("/ticketHub")
        .withAutomaticReconnect()
        .build();

        connection.on("AtualizarAssento", (codigo, novoStatus) => {
        const btn = document.getElementById(`btn-${codigo}`);
        if (!btn) return;

        if (novoStatus === "Reservado") {
        applySeatStatus(btn, 1, null, codigo);
        } else if (novoStatus === "Vendido") {
        applySeatStatus(btn, 2, null, codigo);
        } else if (novoStatus === "Disponivel") {
        applySeatStatus(btn, 0, null, codigo);
        }
        });

        connection.start()
        .then(() => connection.invoke("EntrarNaSalaDoEvento", eventId))
        .catch(err => console.error(err.toString()));
        }

        function applySeatStatus(button, status, donoId, codigo) {
        button.classList.remove("seat-disponivel", "seat-reservado", "seat-vendido", "seat-minha-reserva");
        button.onclick = null; 

        if (status === 0) {
        button.classList.add("seat-disponivel");
        button.disabled = false;
        button.onclick = () => reservarAssento(codigo);
        return;
        }

        if (status === 1) {
        if (currentUserId && donoId && currentUserId.toLowerCase() === donoId.toLowerCase()) {
        button.classList.add("seat-minha-reserva");
        button.disabled = false;
        button.onclick = () => gerenciarMinhaReserva(codigo);
        } else {
        button.classList.add("seat-reservado");
        button.disabled = true;
        }
        return;
        }

        button.classList.add("seat-vendido");
        button.disabled = true;
        }

        function gerenciarMinhaReserva(codigo) {
        document.getElementById('modalReservaMsg').textContent =
            `O assento ${codigo} está reservado para você! Deseja ir ao pagamento ou cancelar a reserva?`;

        const btnIr = document.getElementById('btnIrPagamento');
        const btnCancelar = document.getElementById('btnCancelarReserva');

        btnIr.onclick = () => {
            window.location.href = `/Ticket/Checkout?codigo=${codigo}&eventId=${eventId}`;
        };

        btnCancelar.onclick = () => {
            bootstrap.Modal.getInstance(document.getElementById('modalMinhaReserva')).hide();
            cancelarReservaPost(codigo);
        };

        new bootstrap.Modal(document.getElementById('modalMinhaReserva')).show();
        }

        function reservarAssento(codigo) {
        const form = document.createElement("form");
        form.method = "post";
        form.action = `/Ticket/Reservar?assentoCodigo=${codigo}&eventId=${eventId}`;
        document.body.appendChild(form);
        form.submit();
        }

        function cancelarReservaPost(codigo) {
        const form = document.createElement("form");
        form.method = "post";
        form.action = `/Ticket/CancelarReserva?assentoCodigo=${codigo}&eventId=${eventId}`;
        document.body.appendChild(form);
        form.submit();
        }
    </script>
}